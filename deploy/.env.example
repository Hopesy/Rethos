# Public hostname for automatic HTTPS (must resolve to this machine).
# Pairing links (`docker compose exec rethos node dist-server/pair-cli.js`) point here.
DOMAIN=rethos.example.com

# Engine CLIs baked into the image at build time (space-separated npm packages).
# Sign in afterwards with:  docker compose exec rethos claude   (etc.)
ENGINES="@anthropic-ai/claude-code @openai/codex"

# Optional: let people sign in with an emailed code instead of a pairing
# code. Addresses or @domain entries, comma-separated. Admins get full
# access; members get chat and approvals only.
OMB_SIGNIN_EMAILS=
OMB_SIGNIN_MEMBER_EMAILS=

# Optional: send those codes through your own mail server instead of the
# upstream account service, e.g. smtps://user%40example.com:PASSWORD@smtp.example.com:465
# (docs/self-hosting.md). FROM defaults to the user name when it is an address.
OMB_SIGNIN_SMTP_URL=
OMB_SIGNIN_SMTP_FROM=

COMPOSE_PROJECT_NAME=rethos
RETHOS_IMAGE=ghcr.io/hopesy/rethos:latest
# Set these to reuse an existing data volume.
OMB_DATA_VOLUME=
OMB_DATA_EXTERNAL=false
